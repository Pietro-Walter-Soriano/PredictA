# Optional API keys (never commit the real .env)
# The Odds API (https://the-odds-api.com): pre-match odds incl. Pinnacle for upcoming matches
ODDS_API_KEY=
# Optional: extra bookmaker markets (btts, goal / corner / card lines), one call per match in the hour before kick-off, only to compare with our forecast
ODDS_EXTRA_MAX=8
ODDS_EXTRA_MIN_CREDITS=150
# Optional: extra copy of the dashboard after each run, e.g. PUBLISH_DIR=/mnt/c/Users/Public
PUBLISH_DIR=
